{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "component": "ai-docent",
      "package-name": "ai-docent",
      "release-type": "simple",
      "include-component-in-tag": false,
      "version-file": "version.txt",
      "_comment": "release-as pins the first public release to 0.1.0 while the repo is in preparation. Remove it after v0.1.0 ships so conventional commits drive the version again.",
      "release-as": "0.1.0",
      "extra-files": [
        {
          "type": "generic",
          "path": "skills/foundations/SKILL.md"
        },
        {
          "type": "generic",
          "path": "skills/prompt-craft/SKILL.md"
        },
        {
          "type": "generic",
          "path": "skills/reliability/SKILL.md"
        },
        {
          "type": "generic",
          "path": "skills/security/SKILL.md"
        },
        {
          "type": "generic",
          "path": "skills/mechanics/SKILL.md"
        },
        {
          "type": "generic",
          "path": "skills/builder/SKILL.md"
        },
        {
          "type": "generic",
          "path": "skills/shipping/SKILL.md"
        },
        {
          "type": "json",
          "path": ".claude-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": ".claude-plugin/marketplace.json",
          "jsonpath": "$.plugins[0].version"
        },
        {
          "type": "json",
          "path": ".codex-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": ".cursor-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": ".grok-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": ".grok-plugin/marketplace.json",
          "jsonpath": "$.plugins[0].version"
        },
        {
          "type": "json",
          "path": ".agents/plugins/marketplace.json",
          "jsonpath": "$.plugins[0].version"
        },
        {
          "type": "json",
          "path": "gemini-extension.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
